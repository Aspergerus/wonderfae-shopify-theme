{{ 'wonderfae-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign image_alt = section.settings.image_alt | default: section.settings.image_caption | default: section.settings.heading | escape
  assign desktop_image_position = section.settings.desktop_image_position | default: 'right'
-%}

<section
  class="wonderfae-hero wonderfae-hero--image-{{ desktop_image_position }}{% if section.settings.enable_animations %} wonderfae-hero--animations{% endif %}"
  style="
    --wonderfae-hero-padding-top: {{ section.settings.padding_top }}px;
    --wonderfae-hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --wonderfae-hero-bg: {{ section.settings.background_color }};
    --wonderfae-hero-cream: {{ section.settings.cream_color }};
    --wonderfae-hero-walnut: {{ section.settings.walnut_color }};
    --wonderfae-hero-walnut-deep: {{ section.settings.walnut_deep_color }};
    --wonderfae-hero-ink: {{ section.settings.ink_color }};
    --wonderfae-hero-ink-soft: {{ section.settings.ink_soft_color }};
    --wonderfae-hero-moss: {{ section.settings.moss_color }};
    --wonderfae-hero-gold: {{ section.settings.gold_color }};
    --wonderfae-hero-container: {{ section.settings.max_width }}px;
  "
>
  <div class="wonderfae-hero__light" aria-hidden="true"></div>
  <div class="wonderfae-hero__grain" aria-hidden="true"></div>

  <div class="wonderfae-hero__container">
    <div class="wonderfae-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wonderfae-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        {%- if heading_tag == 'h2' -%}
          <h2 class="wonderfae-hero__wordmark">
            {{ section.settings.heading }}
          </h2>
        {%- else -%}
          <h1 class="wonderfae-hero__wordmark">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <div class="wonderfae-hero__divider" aria-hidden="true">
          <span class="wonderfae-hero__divider-line"></span>
          <svg
            class="wonderfae-hero__divider-leaf"
            viewBox="0 0 24 24"
            focusable="false"
            aria-hidden="true"
          >
            <path d="M20.2 3.8c-5.9.3-10.6 2.2-13.3 5.4-2.1 2.5-2.8 5.7-2 9.3 3.6.8 6.8.1 9.3-2 3.2-2.7 5.1-7.4 5.4-13.3.1-.3-.1-.5-.4-.4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4.8 19.2 15.6 8.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span class="wonderfae-hero__divider-line"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.introduction != blank -%}
        <p class="wonderfae-hero__intro">{{ section.settings.introduction }}</p>
      {%- endif -%}

      <div class="wonderfae-hero__actions">
        {%- if section.settings.primary_button_label != blank -%}
          <a class="wonderfae-hero__button wonderfae-hero__button--primary" href="{{ section.settings.primary_button_link | default: '#' }}">
            {{ section.settings.primary_button_label | escape }}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_button_label != blank -%}
          <a class="wonderfae-hero__button wonderfae-hero__button--secondary" href="{{ section.settings.secondary_button_link | default: '#' }}">
            {{ section.settings.secondary_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <figure class="wonderfae-hero__portrait">
      <div class="wonderfae-hero__image-frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '360, 540, 720, 900, 1080, 1296, 1600',
              sizes: '(min-width: 990px) 38vw, (min-width: 750px) 64vw, 92vw',
              alt: image_alt,
              class: 'wonderfae-hero__image'
          }}
        {%- else -%}
          <img
            class="wonderfae-hero__image"
            src="{{ 'wonderfae-hero.jpg' | asset_url }}"
            alt="{{ image_alt }}"
            width="720"
            height="1080"
            loading="eager"
          >
        {%- endif -%}
      </div>

      {%- if section.settings.image_caption != blank -%}
        <figcaption class="wonderfae-hero__caption">{{ section.settings.image_caption | escape }}</figcaption>
      {%- endif -%}

      {%- if section.settings.show_ornaments -%}
        <span class="wonderfae-hero__sprig wonderfae-hero__sprig--top" aria-hidden="true">
          <span class="wonderfae-hero__sprig-stem"></span>
          <span class="wonderfae-hero__sprig-leaf wonderfae-hero__sprig-leaf--one"></span>
          <span class="wonderfae-hero__sprig-leaf wonderfae-hero__sprig-leaf--two"></span>
          <span class="wonderfae-hero__sprig-leaf wonderfae-hero__sprig-leaf--three"></span>
          <span class="wonderfae-hero__sprig-flower"></span>
        </span>
      {%- endif -%}
    </figure>

    {%- if section.settings.show_ornaments -%}
      <span class="wonderfae-hero__sprig wonderfae-hero__sprig--lower" aria-hidden="true">
        <span class="wonderfae-hero__sprig-stem"></span>
        <span class="wonderfae-hero__sprig-leaf wonderfae-hero__sprig-leaf--one"></span>
        <span class="wonderfae-hero__sprig-leaf wonderfae-hero__sprig-leaf--two"></span>
        <span class="wonderfae-hero__sprig-leaf wonderfae-hero__sprig-leaf--three"></span>
        <span class="wonderfae-hero__sprig-flower"></span>
      </span>
    {%- endif -%}
  </div>

  {%- if section.settings.chapter_text != blank -%}
    <p class="wonderfae-hero__chapter">{{ section.settings.chapter_text | escape }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Wonderfae hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Handmade needle-felted mice"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Wonderfae"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "Handmade, one-of-a-kind mice paired with genuine antique and vintage treasures. Every companion has a name, a number, and a small story of their own."
    },
    {
      "type": "text",
      "id": "chapter_text",
      "label": "Chapter text",
      "default": "Genuine sourced objects, never reproductions"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Available Companions"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Commission Enquiry"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "A needle-felted mouse beside a floral teacup and dried flowers"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "Beatrice, No. 001, with her antique teacup"
    },
    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show decorative divider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ornaments",
      "label": "Show botanical ornaments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable entrance animations",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#e8dcc0"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#f7efdd"
    },
    {
      "type": "color",
      "id": "walnut_color",
      "label": "Walnut",
      "default": "#593a28"
    },
    {
      "type": "color",
      "id": "walnut_deep_color",
      "label": "Deep walnut",
      "default": "#38251b"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Ink",
      "default": "#382d27"
    },
    {
      "type": "color",
      "id": "ink_soft_color",
      "label": "Soft ink",
      "default": "#665246"
    },
    {
      "type": "color",
      "id": "moss_color",
      "label": "Moss",
      "default": "#657257"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Antique gold",
      "default": "#ad8750"
    }
  ],
  "presets": [
    {
      "name": "Wonderfae hero"
    }
  ]
}
{% endschema %}
