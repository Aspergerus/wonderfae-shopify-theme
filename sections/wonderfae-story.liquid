{{ 'wonderfae-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign section_anchor = section.settings.section_anchor | default: 'story' | handleize
  assign desktop_side_position = section.settings.desktop_side_position | default: 'left'
  assign mobile_order = section.settings.mobile_order | default: 'content_first'
-%}

<section
  class="wonderfae-story wonderfae-story--side-{{ desktop_side_position }} wonderfae-story--mobile-{{ mobile_order }}{% if section.settings.enable_animations %} wonderfae-story--animations{% endif %}"
  id="{{ section_anchor }}"
  style="
    --wonderfae-story-padding-top: {{ section.settings.padding_top }}px;
    --wonderfae-story-padding-bottom: {{ section.settings.padding_bottom }}px;
    --wonderfae-story-max-width: {{ section.settings.max_width }}px;
    --wonderfae-story-bg: {{ section.settings.background_color }};
    --wonderfae-story-card-bg: {{ section.settings.card_background_color }};
    --wonderfae-story-cream: {{ section.settings.cream_color }};
    --wonderfae-story-walnut: {{ section.settings.walnut_color }};
    --wonderfae-story-walnut-deep: {{ section.settings.walnut_deep_color }};
    --wonderfae-story-ink: {{ section.settings.ink_color }};
    --wonderfae-story-ink-soft: {{ section.settings.ink_soft_color }};
    --wonderfae-story-moss: {{ section.settings.moss_color }};
    --wonderfae-story-gold: {{ section.settings.gold_color }};
    --wonderfae-story-blush: {{ section.settings.blush_color }};
  "
>
  <div class="wonderfae-story__container">
    <div class="wonderfae-story__layout">
      <aside class="wonderfae-story__keepsake" aria-label="Keepsake note">
        {%- if section.settings.show_botanical_ornament -%}
          <span class="wonderfae-story__sprig" aria-hidden="true">
            <span class="wonderfae-story__sprig-stem"></span>
            <span class="wonderfae-story__sprig-leaf wonderfae-story__sprig-leaf--one"></span>
            <span class="wonderfae-story__sprig-leaf wonderfae-story__sprig-leaf--two"></span>
            <span class="wonderfae-story__sprig-leaf wonderfae-story__sprig-leaf--three"></span>
            <span class="wonderfae-story__sprig-flower"></span>
          </span>
        {%- endif -%}

        {%- if section.settings.keepsake_note != blank -%}
          <p class="wonderfae-story__keepsake-text">{{ section.settings.keepsake_note | escape }}</p>
        {%- endif -%}
      </aside>

      <div class="wonderfae-story__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="wonderfae-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {%- if heading_tag == 'h1' -%}
            <h1 class="wonderfae-story__heading">{{ section.settings.heading }}</h1>
          {%- else -%}
            <h2 class="wonderfae-story__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_divider -%}
          <div class="wonderfae-story__divider" aria-hidden="true">
            <span class="wonderfae-story__divider-line"></span>
            <svg
              class="wonderfae-story__divider-leaf"
              viewBox="0 0 24 24"
              focusable="false"
              aria-hidden="true"
            >
              <path d="M20.2 3.8c-5.9.3-10.6 2.2-13.3 5.4-2.1 2.5-2.8 5.7-2 9.3 3.6.8 6.8.1 9.3-2 3.2-2.7 5.1-7.4 5.4-13.3.1-.3-.1-.5-.4-.4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M4.8 19.2 15.6 8.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span class="wonderfae-story__divider-line"></span>
          </div>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="wonderfae-story__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
          <div class="wonderfae-story__actions">
            {%- if section.settings.cta_link != blank -%}
              <a class="wonderfae-story__button" href="{{ section.settings.cta_link }}">
                {{ section.settings.cta_label | escape }}
              </a>
            {%- elsif request.design_mode -%}
              <span class="wonderfae-story__button">
                {{ section.settings.cta_label | escape }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wonderfae story",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_anchor",
      "label": "Section anchor",
      "default": "story"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Wonderfae Story"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Every mouse has a name, a home, and a tale."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Each Wonderfae companion begins as loose wool and slowly takes shape by hand. Every piece is individually felted, stitched and finished with its own expression, clothing and story.</p><p>Some companions are paired with genuine antique or vintage objects, chosen to feel as though they have always belonged together. These are keepsake pieces made for shelves, celebrations and the quieter rituals of home.</p>"
    },
    {
      "type": "text",
      "id": "keepsake_note",
      "label": "Keepsake note",
      "default": "Every mouse arrives with a handwritten keepsake card."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show decorative divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_botanical_ornament",
      "label": "Show botanical ornament",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Discover the craft"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_side_position",
      "label": "Desktop keepsake position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile order",
      "default": "content_first",
      "options": [
        {
          "value": "content_first",
          "label": "Content first"
        },
        {
          "value": "keepsake_first",
          "label": "Keepsake first"
        }
      ]
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable CSS animations",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 760,
      "max": 1280,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1000
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F1E6CC"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#F8F1E2"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#F8F1E2"
    },
    {
      "type": "color",
      "id": "walnut_color",
      "label": "Walnut",
      "default": "#675444"
    },
    {
      "type": "color",
      "id": "walnut_deep_color",
      "label": "Deep walnut",
      "default": "#294A63"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Ink",
      "default": "#294A63"
    },
    {
      "type": "color",
      "id": "ink_soft_color",
      "label": "Soft ink",
      "default": "#49677A"
    },
    {
      "type": "color",
      "id": "moss_color",
      "label": "Moss",
      "default": "#A8B1A1"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Antique gold",
      "default": "#B68A4A"
    },
    {
      "type": "color",
      "id": "blush_color",
      "label": "Blush",
      "default": "#D4AAA2"
    }
  ],
  "presets": [
    {
      "name": "Wonderfae story"
    }
  ]
}
{% endschema %}
