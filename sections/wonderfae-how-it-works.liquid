{{ 'wonderfae-how-it-works.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_anchor = section.settings.section_anchor | default: 'how-it-works' | handleize
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

<section
  class="wonderfae-how-it-works{% if section.settings.enable_animations %} wonderfae-how-it-works--animations{% endif %}"
  id="{{ section_anchor }}"
  style="
    --wonderfae-how-it-works-padding-top: {{ section.settings.padding_top }}px;
    --wonderfae-how-it-works-padding-bottom: {{ section.settings.padding_bottom }}px;
    --wonderfae-how-it-works-max-width: {{ section.settings.max_width }}px;
    --wonderfae-how-it-works-grid-width: {{ section.settings.grid_width }}px;
    --wonderfae-how-it-works-bg: {{ section.settings.background_color }};
    --wonderfae-how-it-works-cream: {{ section.settings.cream_color }};
    --wonderfae-how-it-works-walnut: {{ section.settings.walnut_color }};
    --wonderfae-how-it-works-walnut-deep: {{ section.settings.walnut_deep_color }};
    --wonderfae-how-it-works-ink: {{ section.settings.ink_color }};
    --wonderfae-how-it-works-ink-soft: {{ section.settings.ink_soft_color }};
    --wonderfae-how-it-works-moss: {{ section.settings.moss_color }};
    --wonderfae-how-it-works-gold: {{ section.settings.gold_color }};
  "
>
  <div class="wonderfae-how-it-works__container">
    <header class="wonderfae-how-it-works__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="wonderfae-how-it-works__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        {%- if heading_tag == 'h1' -%}
          <h1 class="wonderfae-how-it-works__heading">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="wonderfae-how-it-works__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <div class="wonderfae-how-it-works__divider" aria-hidden="true">
          <span class="wonderfae-how-it-works__divider-line"></span>
          <svg
            class="wonderfae-how-it-works__divider-leaf"
            viewBox="0 0 24 24"
            focusable="false"
            aria-hidden="true"
          >
            <path d="M20.2 3.8c-5.9.3-10.6 2.2-13.3 5.4-2.1 2.5-2.8 5.7-2 9.3 3.6.8 6.8.1 9.3-2 3.2-2.7 5.1-7.4 5.4-13.3.1-.3-.1-.5-.4-.4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4.8 19.2 15.6 8.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span class="wonderfae-how-it-works__divider-line"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.introduction != blank -%}
        <div class="wonderfae-how-it-works__intro">{{ section.settings.introduction }}</div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="wonderfae-how-it-works__grid">
        {%- for block in section.blocks -%}
          <article
            class="wonderfae-how-it-works__step"
            {{ block.shopify_attributes }}
          >
            {%- if section.settings.show_step_numbers -%}
              <p class="wonderfae-how-it-works__number" aria-hidden="true">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </p>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="wonderfae-how-it-works__step-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <div class="wonderfae-how-it-works__step-body">{{ block.settings.body }}</div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="wonderfae-how-it-works__empty">
        Add process steps to describe how Wonderfae works.
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wonderfae process",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "section_anchor",
      "label": "Section anchor",
      "default": "how-it-works"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How Wonderfae works"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly, sourced carefully"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "Wonderfae pieces are keepsakes built around character, provenance, and small details."
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show decorative divider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_step_numbers",
      "label": "Show step numbers",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable CSS animations",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 760,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "grid_width",
      "min": 720,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Grid width",
      "default": 1060
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7efdd"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#f7efdd"
    },
    {
      "type": "color",
      "id": "walnut_color",
      "label": "Walnut",
      "default": "#593a28"
    },
    {
      "type": "color",
      "id": "walnut_deep_color",
      "label": "Deep walnut",
      "default": "#38251b"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Ink",
      "default": "#382d27"
    },
    {
      "type": "color",
      "id": "ink_soft_color",
      "label": "Soft ink",
      "default": "#665246"
    },
    {
      "type": "color",
      "id": "moss_color",
      "label": "Moss",
      "default": "#657257"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Antique gold",
      "default": "#ad8750"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Process step"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Describe this part of the Wonderfae process.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wonderfae process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "One mouse at a time",
            "body": "<p>Each piece is handmade, named, and numbered. No two mice or object pairings are exactly the same.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Original vintage objects",
            "body": "<p>Teacups, tins, dishes, books, bobbins, and reels are genuine sourced originals, not reproductions.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Thoughtful commissions",
            "body": "<p>Customers can request a separate mouse inspired by their own object using photos only. Wonderfae does not handle customer-owned antiques.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
